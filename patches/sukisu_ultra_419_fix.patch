--- a/infra/kernel_compat.h
+++ b/infra/kernel_compat.h
@@ -335,4 +335,16 @@ static inline struct file *ksu_filp_open_nonotify(const char *path, int flags)
     return f;
 }
 
+
+// https://github.com/torvalds/linux/commit/294f69e662d1570703e9b56e95be37a9fd3afba5
+#ifndef __has_attribute
+#define __has_attribute(x) __GCC4_has_attribute_##x
+#define __GCC4_has_attribute___fallthrough__ 0
+#endif
+#if __has_attribute(__fallthrough__)
+#define fallthrough __attribute__((__fallthrough__))
+#else
+#define fallthrough do { } while (0) /* fallthrough */
+#endif
+
 #endif
